# Producción del backend (copiar a backend/.env en el servidor y completar). Sin secretos en este archivo.
# Ver docs/runbook.md y docs/adr/ADR-005-destino-de-deploy.md.

APP_NAME=INDUFOR
APP_ENV=production
APP_KEY=                       # php artisan key:generate (una sola vez; rotarlo invalida sesiones)
APP_DEBUG=false
APP_URL=https://api.indufor.example
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# La SPA vive en otro subdominio del mismo dominio: cookies de sesión compartidas con SameSite=Lax
FRONTEND_URL=https://app.indufor.example
SANCTUM_STATEFUL_DOMAINS=app.indufor.example
SESSION_DOMAIN=.indufor.example
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=indufor_db
DB_USERNAME=indufor            # usuario propio con permisos solo sobre indufor_db, nunca root
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=sync          # no hay colas: la exportación corre al terminar la respuesta (ADR-004)
FILESYSTEM_DISK=local

# Logs diarios sin datos sensibles; los errores de la API llegan al cliente sin trazas (ADR-002)
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

BCRYPT_ROUNDS=12
LOGIN_MAX_ATTEMPTS=5
API_MAX_PER_MINUTE=120

# Backups (deploy/scripts/backup.sh)
BACKUP_DIR=/var/backups/indufor
BACKUP_RETENCION_DIAS=30
BACKUP_GPG_RECIPIENT=          # opcional: clave pública para cifrar los backups
